{
  "manifest_version": 3,
  "name": "Alaxee Proxy",
  "short_name": "Alaxee Proxy",
  "version": "0.2.0",
  "description": "A lightweight Edge proxy controller with direct whitelist and force-proxy domain rules.",
  "permissions": [
    "proxy",
    "storage",
    "activeTab",
    "alarms"
  ],
  "action": {
    "default_title": "Alaxee Proxy",
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "icons/status/clash16.png",
      "32": "icons/status/clash32.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_ui": {
    "page": "settings.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "optional_permissions": [
    "tabs"
  ],
  "host_permissions": [
    "https://xcvxpallbauhpgigyxeh.supabase.co/*"
  ]
}
